{
  "name": "@crm/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\"",
    "test:coverage": "vitest run --passWithNoTests --coverage --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\""
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@crm/config": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/email": "workspace:*",
    "@crm/observability": "workspace:*",
    "@crm/permissions": "workspace:*",
    "better-auth": "1.7.7",
    "zod": "4.6.5",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@crm/eslint-config": "workspace:*",
    "@crm/tsconfig": "workspace:*",
    "@types/node": "^26",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3"
  }
}
