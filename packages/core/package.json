{
  "name": "@crm/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./audit": "./src/modules/audit/index.ts",
    "./billing": "./src/modules/billing/index.ts",
    "./crypto": "./src/lib/crypto.ts",
    "./integrations": "./src/modules/integrations/index.ts",
    "./messaging": "./src/modules/messaging/index.ts",
    "./organizations": "./src/modules/organizations/index.ts",
    "./teams": "./src/modules/teams/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\"",
    "test:coverage": "vitest run --passWithNoTests --coverage --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\""
  },
  "dependencies": {
    "@crm/billing": "workspace:*",
    "@crm/channels": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/observability": "workspace:*",
    "@crm/permissions": "workspace:*",
    "zod": "4.6.5",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@crm/eslint-config": "workspace:*",
    "@crm/tsconfig": "workspace:*",
    "@types/node": "^26",
    "eslint": "10.12.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@crm/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.3"
  }
}
