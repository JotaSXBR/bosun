{
  "name": "@crm/automation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\"",
    "test:coverage": "vitest run --passWithNoTests --coverage --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\""
  },
  "dependencies": {
    "@crm/channels": "workspace:*",
    "@crm/config": "workspace:*",
    "@crm/core": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/observability": "workspace:*",
    "pg-boss": "12.35.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@crm/eslint-config": "workspace:*",
    "@crm/tsconfig": "workspace:*",
    "@types/node": "^26",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
