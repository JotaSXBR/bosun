    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3"
  }
