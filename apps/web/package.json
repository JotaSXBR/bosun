{
  "name": "@crm/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\" --exclude \"e2e/**\"",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --passWithNoTests --coverage --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\" --exclude \"e2e/**\""
  },
  "dependencies": {
    "@crm/auth": "workspace:*",
    "@crm/automation": "workspace:*",
    "@crm/config": "workspace:*",
    "@crm/core": "workspace:*",
    "@crm/db": "workspace:*",
    "@crm/permissions": "workspace:*",
    "@crm/ui": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@next/env": "16.3.8",
    "better-auth": "1.7.7",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5",
    "drizzle-orm": "0.45.3",
    "@crm/observability": "workspace:*",
    "@sentry/nextjs": "11.4.0",
    "@vercel/otel": "2.1.3",
    "@opentelemetry/api": "1.9.1"
