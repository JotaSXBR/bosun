# ---- APP ----
NODE_ENV=development
APP_URL=http://localhost:3000
# Root .env is the single source of truth for the whole monorepo:
# apps/web loads it via next.config.ts (@next/env), and db/tooling scripts
# load it via dotenv. Copy this file to `.env` and adjust.

# ---- DATABASE ----
POSTGRES_PORT=5432
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
# App role (subject to RLS). Used by the application.
DATABASE_URL=postgres://crm_app:crm_app@localhost:5432/crm
# Owner role (bypasses RLS). Used only by migrations/seed of grants.
DATABASE_ADMIN_URL=postgres://crm:crm@localhost:5432/crm
# Password for the crm_app role created by docker/postgres/init.
CRM_APP_PASSWORD=crm_app

# ---- REDIS ----
# Available via compose; nothing uses it yet.
REDIS_URL=redis://localhost:6379

# ---- AUTH ----
# Required, min 32 chars. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# ---- AI ----
# Product-config group `ai` — can be set encrypted in platform_settings via
# /app/settings instead of env. DB values win over env when both exist.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# ---- WHATSAPP (shared notes: pick WAHA (unofficial) or Meta Cloud API) ----

# AES-256-GCM key (64 hex chars = 32 bytes) encrypting channel_connections
# credentials at rest. Optional — required only to create/read connections.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#CHANNEL_CREDENTIALS_KEY=

# ---- META (WhatsApp Cloud API) ----
# Product-config group `meta` — platform defaults for app-level secrets; a
# connection that omits appSecret/verifyToken inherits these. Editable in
# /app/settings (DB wins over env).
#META_APP_SECRET=
#META_VERIFY_TOKEN=
#META_ACCESS_TOKEN=
#META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v26.0

# ---- WAHA ----
#WAHA_BASE_URL=
#WAHA_API_KEY=
#WAHA_WEBHOOK_HMAC_KEY=

# ---- STORAGE (RustFS locally, any S3-compatible in prod) ----
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=crm
STORAGE_S3_ACCESS_KEY_ID=rustfsadmin
STORAGE_S3_SECRET_ACCESS_KEY=rustfsadmin
STORAGE_S3_FORCE_PATH_STYLE=true

# ---- BILLING (Asaas) ----
# Product-config group `billing` — editable in /app/settings (DB wins over env).
#ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
#ASAAS_WEBHOOK_TOKEN=

# ---- EMAIL ----
# Product-config group `email` — editable in /app/settings; on a fresh install
# the platform admin is routed through /app/setup until this resolves.
# DB wins over env when both exist.
EMAIL_PROVIDER=console
EMAIL_FROM=CRM <no-reply@crm.local>
#RESEND_API_KEY=
#SMTP_HOST=
#SMTP_PORT=
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_SECURE=

# ---- OBSERVABILITY ----
#SENTRY_DSN=
#OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=crm-web
LOG_LEVEL=info
